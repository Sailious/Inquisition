# ===========================================================================
# Inquisition 审判庭 - 环境变量配置示例
# ===========================================================================
# 复制本文件为 .env 并填写真实值，切勿将 .env 提交到代码仓库。
# 部署时通过环境变量注入（Docker -e / docker-compose environment / K8s ConfigMap 等）。
# ===========================================================================

# ---------------------------------------------------------------------------
# [必须] JWT 签名密钥
# 安全要求：不少于 32 字符的随机字符串，否则服务拒绝启动
# 生成示例: openssl rand -hex 32
# ---------------------------------------------------------------------------
INQUISITION_SECRET=

# ---------------------------------------------------------------------------
# [必须] 数据库配置
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inquisition
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# CORS 跨域配置
# ENABLED: 总开关
#   false = 完全禁用跨域，仅允许同源访问（最严格）
#   true  = 启用，具体放行范围由 ORIGINS 决定
# ORIGINS: 白名单，逗号分隔的合法前端域名
#   *             = 允许所有来源（仅建议本地调试，有安全风险）
#   具体域名      = 白名单模式（生产推荐）
#   留空          = 仅允许同源访问
# 示例: https://ark.example.com,https://admin.ark.example.com
# ---------------------------------------------------------------------------
INQUISITION_CORS_ENABLED=true
INQUISITION_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 开发模式（生产环境必须为 false）
# 开启后跳过所有 JWT 鉴权，仅限本地调试
# ---------------------------------------------------------------------------
INQUISITION_DEV_MODE=false

# ---------------------------------------------------------------------------
# SSL 配置（启用 HTTPS 时填写）
# ---------------------------------------------------------------------------
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=

# ---------------------------------------------------------------------------
# 邮件通知配置
# ---------------------------------------------------------------------------
MAIL_ENABLE=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_NICKNAME=阿戈尔科技

# ---------------------------------------------------------------------------
# WxPusher 微信推送配置
# 获取: https://wxpusher.zjiecode.com/
# ---------------------------------------------------------------------------
WXPUSHER_ENABLE=false
WXPUSHER_APP_TOKEN=

# ---------------------------------------------------------------------------
# Qmsg QQ 消息推送配置
# 获取: https://qmsg.zendee.cn/
# ---------------------------------------------------------------------------
QMSG_ENABLE=false
QMSG_KEY=

# ---------------------------------------------------------------------------
# 腾讯云 COS 对象存储（日志截图存储）
# 获取: https://console.cloud.tencent.com/cam/capi
# ---------------------------------------------------------------------------
OSS_ENABLE=false
OSS_SECRET_ID=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=

# ---------------------------------------------------------------------------
# CHFS 文件存储服务（日志截图存储备选方案）
# ---------------------------------------------------------------------------
CHFS_ENABLE=false
CHFS_URL=
CHFS_USERNAME=
CHFS_PASSWORD=
CHFS_UPLOAD_DIR=/inquisition/log/img

# ---------------------------------------------------------------------------
# 每日托管价格（元/天）
# ---------------------------------------------------------------------------
INQUISITION_PRICE_DAILY=1.0

# ---------------------------------------------------------------------------
# 初始管理员账号（仅首次初始化、admin 表为空时生效）
# USERNAME: 账号名，默认 root
# PASSWORD: 初始密码
#   填写   = 用该密码创建账号，密码不会写入日志（推荐）
#   留空   = 随机生成 24 位密码并明文打印到日志，需自行清理日志
# 无论哪种方式，都请在首次登录后立即修改密码
# ---------------------------------------------------------------------------
INQUISITION_ADMIN_INIT_USERNAME=root
INQUISITION_ADMIN_INIT_PASSWORD=

# ---------------------------------------------------------------------------
# 日志定时清理配置
# ENABLED: 是否启用日志定时清理，默认 false
#          该操作为不可逆的物理删除，请确认留存合规要求后再显式开启
# RETENTION_DAYS: 日志保留天数，必须大于 0，早于该天数的日志将被物理删除
#                 配置为 0 或负数时清理任务直接跳过，避免误删整表
# CLEAN_CRON: 清理执行周期（cron 表达式），默认每天凌晨 3 点
#             表达式留空或非法时自动回退为默认值并记录警告
# BATCH_SIZE: 单批删除条数，分批执行以避免长事务锁表
# MAX_BATCHES: 单轮最多执行的批次数，剩余部分留待下一轮，
#              避免长时间独占调度线程而阻塞其它定时任务
# ---------------------------------------------------------------------------
INQUISITION_LOG_CLEAN_ENABLED=false
INQUISITION_LOG_RETENTION_DAYS=30
INQUISITION_LOG_CLEAN_CRON=0 0 3 * * ?
INQUISITION_LOG_CLEAN_BATCH_SIZE=1000
INQUISITION_LOG_CLEAN_MAX_BATCHES=20
